{
  "name": "defilordi",
  "productName": "DefilOrdi",
  "version": "0.8.15",
  "description": "Logiciel pédagogique pour apprendre à se servir du clavier d'un ordinateur",
  "author": "DefilOrdi",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
